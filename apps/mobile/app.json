{
  "expo": {
    "name": "TEMPO",
    "slug": "tempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/tempo-app-icon.png",
    "scheme": "tempo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tempo.discipline",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17202A",
        "foregroundImage": "./assets/brand/tempo-mark.png",
        "monochromeImage": "./assets/brand/tempo-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tempo.discipline"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/tempo-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/tempo-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#F5F5F0",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Tempo to hear what you need to do today.",
          "speechRecognitionPermission": "Allow Tempo to turn your words into a daily plan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
