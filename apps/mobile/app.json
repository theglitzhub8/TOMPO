{
  "expo": {
    "name": "TEMPO",
    "slug": "tempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/tempo-app-icon.png",
    "scheme": "tempo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.theglitzhub.tempo",
      "appleTeamId": "PTMQYUSUAT",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B57FF",
        "foregroundImage": "./assets/brand/tempo-mark.png",
        "monochromeImage": "./assets/brand/tempo-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.theglitzhub.tempo",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/tempo-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/tempo-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#0F1120",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Tempo to hear what you need to do today.",
          "speechRecognitionPermission": "Allow Tempo to turn your words into a daily plan."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2B57FF"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.theglitzhub.tempo",
          "widgets": [
            {
              "name": "TempoNext",
              "displayName": "Tempo Next",
              "description": "Your next planned task, one thing at a time.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Tempo to show calendar events so you can choose which appointments to add to your plan."
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
