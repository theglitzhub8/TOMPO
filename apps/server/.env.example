DATABASE_URL=postgres://tempo:REPLACE_WITH_DB_PASSWORD@127.0.0.1:55432/tempo
HOST=127.0.0.1
PORT=8787
# AI (task capture and the voice assistant) runs on Moonshot Kimi. Keep the key on the server only.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3.1-pro
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
CORS_ORIGINS=
NODE_ENV=development
# Optional password recovery. Use a verified Resend sender; never put this key in the mobile app.
RESEND_API_KEY=
TEMPO_MAIL_FROM=
# Optional Login with Hafrik. Copy the App ID and App Secret from the Hafrik developer app; never put the secret in the mobile app.
# Hafrik's registered callback must be https://<this API>/v1/auth/hafrik/callback.
HAFRIK_APP_ID=
HAFRIK_APP_SECRET=
# HAFRIK_BASE_URL=https://hafrik.com
# HAFRIK_APP_REDIRECT=tempo://auth/hafrik
